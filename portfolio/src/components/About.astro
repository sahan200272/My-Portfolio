---
const skillGroups = [
  {
    category: "Programming Languages",
    items: ["Java", "JavaScript", "TypeScript", "Kotlin", "Python"]
  },
  {
    category: "Frontend",
    items: ["React", "Next.js", "Astro", "HTML", "CSS", "Tailwind CSS"]
  },
  {
    category: "Backend",
    items: ["Spring Boot", "Node.js", "Express.js", "REST APIs"]
  },
  {
    category: "Databases",
    items: ["MongoDB", "MySQL", "Firebase Firestore"]
  },
  {
    category: "Mobile Development",
    items: ["Flutter", "Android (Kotlin)", "React Native"]
  },
  {
    category: "Tools & Platforms",
    items: ["Git & GitHub", "Netlify", "Postman", "Android Studio", "VS Code", "IntelliJ IDEA"]
  }
];
---

<section id="about" class="about-section">
  <div class="container">
    <div class="about-header">
      <h2>About Me</h2>
    </div>

    <div class="about-content">
      <div class="about-image">
        <div class="image-wrapper">
          <img src="/src/assets/My Image.jpeg" alt="Sahan Profile" />
        </div>
      </div>

      <div class="about-text">
        <div class="bio-box">
          <p>
            I’m a <strong>Software Engineering undergraduate</strong> at Sri Lanka Institute of Information Technology, currently in my 3rd year of study. 
            I have hands-on experience in full-stack web and mobile application development.
          </p>
          <p>
            I enjoy building real-world projects, learning new technologies, and writing clean, maintainable code. 
            My goal is to become a high-impact Software Engineer specializing in scalable digital solutions.
          </p>
        </div>
        
        <a href="/my-cv.pdf" download="Sahan_CV.pdf" class="btn-download">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          Download CV
        </a>
      </div>
    </div>

    <h3 class="skills-title">Technical Skills</h3>
    <div class="skills-container">
      {
        skillGroups.map((group) => (
          <div class="skill-category">
            <h4>{group.category}</h4>
            <div class="skill-list">
              {group.items.map((item) => (
                <span class="skill-pill">{item}</span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .about-section {
    background: #000;
    color: #fff;
    padding: 100px 0;
  }
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* Header */
  .about-header {
    text-align: center;
    margin-bottom: 4rem;
  }
  .about-header h2 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
    color: #ff8c00;
  }
  .subtitle {
    color: #ccc;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 2px;
  }

  /* Content Layout */
  .about-content {
    display: flex;
    gap: 4rem;
    align-items: center;
    margin-bottom: 5rem;
  }
  .about-image {
    flex: 1;
    display: flex;
    justify-content: center;
  }
  .image-wrapper {
    width: 350px;
    height: 450px;
    background: #1a1a1a;
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid #333;
  }
  .image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
    transition: 0.5s;
  }
  .image-wrapper:hover img {
    filter: grayscale(0%);
  }

  .about-text {
    flex: 1;
  }
  .bio-box p {
    line-height: 1.8;
    color: #ccc;
    margin-bottom: 1.5rem;
    font-size: 1.1rem;
  }
  .bio-box strong {
    color: #ff8c00;
  }

  .btn-download {
    background: #ff8c00;
    color: #fff;
    padding: 0.8rem 1.5rem;
    border-radius: 5px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: bold;
    transition: 0.3s;
  }
  .btn-download:hover {
    background: #e67e00;
    transform: translateY(-2px);
  }

  /* Skills Section */
  .skills-title {
    text-align: center;
    font-size: 1.8rem;
    margin-bottom: 3rem;
    color: #fff;
  }
  .skills-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }
  .skill-category {
    background: #111;
    padding: 1.5rem;
    border-radius: 12px;
    border: 1px solid #222;
  }
  .skill-category h4 {
    color: #ff8c00;
    margin-bottom: 1rem;
    font-size: 1.1rem;
    border-bottom: 1px solid #222;
    padding-bottom: 0.5rem;
  }
  .skill-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .skill-pill {
    background: #222;
    color: #ddd;
    padding: 5px 12px;
    border-radius: 4px;
    font-size: 0.85rem;
    border: 1px solid #333;
  }

  @media (max-width: 900px) {
    .about-content {
      flex-direction: column;
      text-align: center;
    }
    .image-wrapper {
      width: 280px;
      height: 350px;
    }
  }
</style>