---
const skills = [
  { name: "Figma", level: "100%", icon: "figma" },
  { name: "Adobe XD", level: "100%", icon: "xd" },
  { name: "Adobe Photoshop", level: "85%", icon: "ps" },
  { name: "Adobe Illustrator", level: "60%", icon: "ai" },
  { name: "Adobe Premiere", level: "70%", icon: "pr" },
];
---

<section id="about" class="about-section">
  <div class="container">
    <div class="about-header">
      <h2>About Me</h2>
      <p class="subtitle">User Interface And User Experience And Also Video Editing</p>
    </div>

    <div class="about-content">
      <div class="about-image">
        <div class="image-wrapper">
          <img src="/your-photo-2.png" alt="Sahan Profile" />
        </div>
      </div>
      
      <div class="about-text">
        <p>
          A software engineer, the modern-day architect of digital realms, navigates the ethereal landscapes of code...
          (Insert your full bio text here)
        </p>
        <a href="#" class="btn-download">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
          Download CV
        </a>
      </div>
    </div>

    <div class="skills-grid">
      {skills.map(skill => (
        <div class="skill-item">
          <div class="progress-circle" style={`--percent: ${skill.level.replace('%', '')}`}>
            <div class="inner-circle">
               <span>{skill.icon.toUpperCase()}</span>
            </div>
          </div>
          <div class="skill-info">
            <span class="percentage">{skill.level}</span>
            <span class="skill-name">{skill.name}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .about-section { background: #000; color: #fff; padding: 100px 0; }
  .container { max-width: 1200px; margin: 0 auto; padding: 0 2rem; }
  
  .about-header { text-align: center; margin-bottom: 4rem; }
  .about-header h2 { font-size: 2.5rem; margin-bottom: 0.5rem; }
  .subtitle { color: #ccc; font-size: 0.9rem; }

  .about-content { display: flex; gap: 4rem; align-items: center; margin-bottom: 5rem; }
  .about-image { flex: 1; display: flex; justify-content: center; }
  .image-wrapper { width: 350px; height: 450px; background: #1a1a1a; border-radius: 20px; overflow: hidden; }
  .image-wrapper img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(100%); }

  .about-text { flex: 1; }
  .about-text p { line-height: 1.8; color: #ccc; margin-bottom: 2rem; font-size: 0.95rem; }
  
  .btn-download { 
    background: #ff8c00; color: #fff; padding: 0.8rem 1.5rem; 
    border-radius: 5px; text-decoration: none; display: inline-flex; 
    align-items: center; gap: 10px; font-weight: bold;
  }

  /* Skills Circular Progress */
  .skills-grid { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .skill-item { text-align: center; flex: 1; min-width: 150px; }
  
  .progress-circle {
    width: 120px; height: 120px; border-radius: 50%;
    background: conic-gradient(#ff8c00 calc(var(--percent) * 1%), #333 0);
    display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem;
  }
  
  .inner-circle {
    width: 100px; height: 100px; background: #000; border-radius: 50%;
    display: flex; align-items: center; justify-content: center; font-weight: bold;
  }

  .percentage { display: block; color: #ff8c00; font-size: 1.2rem; font-weight: bold; }
  .skill-name { color: #ccc; font-size: 0.85rem; }

  @media (max-width: 900px) {
    .about-content { flex-direction: column; text-align: center; }
    .skills-grid { justify-content: center; gap: 2rem; }
  }
</style>