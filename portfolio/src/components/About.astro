---
import { Image } from 'astro:assets';
import ProfileImg from '../assets/My Image.jpg';

const skillCategories = [
  {
    category: "Languages & Core",
    icon: "ri-code-box-line",
    items: ["Java", "JavaScript (ES6+)", "TypeScript", "Python", "C++", "Dart", "Kotlin"]
  },
  {
    category: "Backend & Systems",
    icon: "ri-server-line",
    items: ["Spring Boot", "Node.js", "Express.js", "RESTful APIs", "Microservices Architecture"]
  },
  {
    category: "Frontend & Mobile",
    icon: "ri-smartphone-line",
    items: ["React", "Next.js (App Router)", "Flutter", "Tailwind CSS", "Astro", "Vite"]
  },
  {
    category: "Databases & Storage",
    icon: "ri-database-2-line",
    items: ["MongoDB Atlas", "PostgreSQL", "Firebase Firestore", "Cloudinary CDN"]
  },
  {
    category: "DevOps & Tooling",
    icon: "ri-terminal-box-line",
    items: ["Docker", "Kubernetes", "Git & GitHub", "Jest", "Supertest", "Artillery (Load Testing)"]
  }
];
---

<section id="about" class="about-section">
  <div class="container">
    <div class="about-grid">
      <div class="about-visual">
        <div class="image-wrapper">
          <Image 
            src={ProfileImg} 
            alt="Sahan Munasingha" 
            class="profile-image" 
          />
        </div>
      </div>

      <div class="about-text">
        <span class="badge-tag">About Me</span>
        <h2 class="section-title">Architecting systems with modern code & engineering rigor.</h2>
        
        <p class="bio-paragraph">
          I am a Software Engineering student at the <strong>Sri Lanka Institute of Information Technology (SLIIT)</strong>. My engineering focus centers on building resilient microservices, high-throughput APIs, and clean user interfaces that solve tangible problems.
        </p>

        <p class="bio-paragraph">
          Having worked across both enterprise Java ecosystems (Spring Boot, Kubernetes, Docker) and fast-paced web/mobile stacks (React, Node.js, Flutter), I prioritize scalable design patterns, decoupled architectures, and continuous performance testing.
        </p>

        <div class="experience-strip">
          <div class="exp-item">
            <span class="exp-title">Education</span>
            <span class="exp-desc">BSc (Hons) in Software Engineering, SLIIT</span>
          </div>
          <div class="exp-item">
            <span class="exp-title">Focus</span>
            <span class="exp-desc">Distributed Systems & Full-Stack Applications</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Skills Category Grid -->
    <div class="skills-block">
      <div class="skills-header">
        <span class="badge-tag">Technical Competencies</span>
        <h3 class="skills-heading">Tools & Frameworks I Build With</h3>
      </div>

      <div class="skills-grid">
        {skillCategories.map((group) => (
          <div class="skill-card">
            <div class="skill-card-header">
              <i class={group.icon}></i>
              <h4>{group.category}</h4>
            </div>
            <div class="pill-wrap">
              {group.items.map((item) => (
                <span class="skill-pill">{item}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .about-section {
    padding: 100px 0;
    background: #09090b;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 4rem;
    align-items: center;
    margin-bottom: 6rem;
  }

  .about-visual {
    display: flex;
    justify-content: center;
  }

  .image-wrapper {
    width: 340px;
    height: 420px;
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid var(--border-dark);
    background: #18181b;
  }

  .profile-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(15%);
    transition: transform 0.4s ease;
  }

  .image-wrapper:hover .profile-image {
    transform: scale(1.02);
  }

  .badge-tag {
    display: inline-block;
    color: var(--accent);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 0.75rem;
  }

  .section-title {
    font-size: 2.4rem;
    line-height: 1.25;
    font-weight: 800;
    color: #fff;
    margin-bottom: 1.5rem;
  }

  .bio-paragraph {
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.7;
    margin-bottom: 1.2rem;
  }

  .bio-paragraph strong {
    color: #ffffff;
  }

  .experience-strip {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-dark);
  }

  .exp-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .exp-title {
    font-size: 0.8rem;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .exp-desc {
    font-size: 0.95rem;
    color: #ffffff;
    font-weight: 600;
  }

  /* Skills Block */
  .skills-block {
    margin-top: 4rem;
  }

  .skills-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .skills-heading {
    font-size: 2.2rem;
    font-weight: 800;
    color: #fff;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .skill-card {
    background: #121215;
    border: 1px solid var(--border-dark);
    padding: 1.75rem;
    border-radius: 14px;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .skill-card-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--accent);
  }

  .skill-card-header i {
    font-size: 1.3rem;
  }

  .skill-card-header h4 {
    color: #fff;
    font-size: 1.05rem;
    font-weight: 700;
  }

  .pill-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .skill-pill {
    background: #18181b;
    border: 1px solid #27272a;
    color: #d4d4d8;
    padding: 0.35rem 0.75rem;
    border-radius: 6px;
    font-size: 0.82rem;
    font-weight: 500;
  }

  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .about-visual {
      order: -1;
    }
    .experience-strip {
      grid-template-columns: 1fr;
    }
  }
</style>