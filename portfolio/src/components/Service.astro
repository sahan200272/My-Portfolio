---
const capabilities = [
  {
    title: "Backend & Microservices",
    icon: "ri-server-line",
    description: "Designing decoupled, event-driven architectures with Spring Boot and Node.js. Establishing stateless JWT security, database boundaries, and fault-tolerant communication.",
  },
  {
    title: "Full-Stack Web Engineering",
    icon: "ri-window-line",
    description: "Building responsive, accessible web applications using React, Next.js, and Astro with strict typing in TypeScript and optimized asset delivery.",
  },
  {
    title: "Cross-Platform Mobile",
    icon: "ri-smartphone-line",
    description: "Creating fluid mobile experiences with Flutter and Dart, integrating cloud datastores (Firebase), and managing asynchronous application state.",
  },
  {
    title: "DevOps & Containerization",
    icon: "ri-cloud-line",
    description: "Containerizing services with multi-stage Docker builds, orchestrating workloads via Kubernetes manifests, and managing CI/CD deployment pipelines.",
  }
];
---

<section id="service" class="services-section">
  <div class="container">
    <div class="header">
      <span class="sub-title">Engineering Capabilities</span>
      <h2>Core <span class="highlight">Expertise</span></h2>
      <p class="section-desc">
        End-to-end technical execution across systems architecture, application engineering, and infrastructure automation.
      </p>
    </div>

    <div class="services-grid">
      {capabilities.map((item) => (
        <div class="service-card">
          <div class="icon-box">
            <i class={item.icon}></i>
          </div>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .services-section {
    background: #09090b;
    padding: 100px 0;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .sub-title {
    color: var(--accent);
    text-transform: uppercase;
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    display: block;
    margin-bottom: 0.5rem;
  }

  h2 {
    font-size: 2.6rem;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .highlight {
    color: var(--accent);
  }

  .section-desc {
    color: var(--text-muted);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
    font-size: 1.05rem;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 2rem;
  }

  .service-card {
    background: #121215;
    border: 1px solid var(--border-dark);
    padding: 2.5rem 1.75rem;
    border-radius: 16px;
    transition: all 0.25s ease;
    display: flex;
    flex-direction: column;
  }

  .service-card:hover {
    transform: translateY(-6px);
    border-color: rgba(255, 140, 0, 0.4);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.5);
  }

  .icon-box {
    width: 54px;
    height: 54px;
    background: rgba(255, 140, 0, 0.1);
    color: var(--accent);
    border: 1px solid rgba(255, 140, 0, 0.2);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
  }

  h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0.85rem;
  }

  p {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }
</style>