---
const projects = [
  {
    name: "PulseCare — Distributed Healthcare & Telemedicine",
    category: "Microservices",
    badge: "Distributed Systems & Cloud",
    description: "An AI-enabled telemedicine and booking platform built with Spring Boot microservices, Next.js, and containerized using Docker and Kubernetes. Features WebRTC consultations and isolated Database-per-Service patterns.",
    tech: ["Spring Boot 3", "Next.js 14", "Docker", "Kubernetes", "PostgreSQL", "WebRTC"],
    github: "https://github.com/sahan200272/healthcare-microservices-system.git",
    live: null, // Self-hosted orchestration
    metrics: "Docker Compose & K8s Manifests"
  },
  {
    name: "Greenvy — Sustainable Product Rating Platform",
    category: "Full-Stack",
    badge: "AI & Sustainability (SDG 12)",
    description: "Full-stack web application evaluating consumer product eco-scores via Google Gemini AI. Features JWT role-based access, Perspective API content moderation, and Artillery performance stress testing.",
    tech: ["React", "Node.js", "Express", "MongoDB Atlas", "Gemini AI", "Tailwind CSS"],
    github: "https://github.com/sahan200272/sustainable-product-rating-extension",
    live: "https://greenvy.vercel.app",
    metrics: "50+ Concurrent User Test"
  },
  {
    name: "Breezely — Weather & Activity Assistant",
    category: "Mobile",
    badge: "Cross-Platform Mobile",
    description: "Cross-platform mobile application delivering real-time forecasts, contextual clothing recommendations, and interactive radar visualizations with clean offline caching.",
    tech: ["Flutter", "Dart", "REST API", "State Management"],
    github: "https://github.com/sahan200272",
    live: null,
    metrics: "Mobile Architecture"
  }
];
---

<section id="portfolio" class="portfolio-section">
  <div class="container">
    <div class="section-header">
      <span class="badge-tag">Featured Engineering</span>
      <h2 class="title">Systems & Applications I've Built</h2>
      <p class="subtitle">
        Architectural highlights, live deployments, and open-source code repositories.
      </p>
    </div>

    <div class="projects-list">
      {projects.map((project) => (
        <div class="project-card">
          <div class="card-content">
            <div class="meta-row">
              <span class="category-badge">{project.badge}</span>
              <span class="metrics-pill">{project.metrics}</span>
            </div>

            <h3 class="project-name">{project.name}</h3>
            <p class="project-desc">{project.description}</p>

            <div class="tech-stack">
              {project.tech.map((t) => (
                <span class="tech-tag">{t}</span>
              ))}
            </div>

            <div class="card-links">
              {project.live && (
                <a href={project.live} target="_blank" rel="noopener noreferrer" class="btn-live">
                  <i class="ri-external-link-line"></i>
                  <span>Live App</span>
                </a>
              )}
              <a href={project.github} target="_blank" rel="noopener noreferrer" class="btn-github">
                <i class="ri-github-line"></i>
                <span>Repository</span>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .portfolio-section {
    padding: 100px 0;
    background: #09090b;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .section-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .badge-tag {
    color: var(--accent);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    display: block;
    margin-bottom: 0.5rem;
  }

  .title {
    font-size: 2.6rem;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 0.8rem;
  }

  .subtitle {
    color: var(--text-muted);
    font-size: 1.05rem;
    max-width: 600px;
    margin: 0 auto;
  }

  .projects-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 2rem;
  }

  .project-card {
    background: #121215;
    border: 1px solid var(--border-dark);
    border-radius: 16px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .project-card:hover {
    transform: translateY(-4px);
    border-color: rgba(255, 140, 0, 0.4);
  }

  .meta-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.2rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .category-badge {
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .metrics-pill {
    background: #18181b;
    border: 1px solid #27272a;
    color: #a1a1aa;
    font-size: 0.75rem;
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
  }

  .project-name {
    font-size: 1.35rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }

  .project-desc {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .tech-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 2rem;
  }

  .tech-tag {
    background: #18181b;
    color: #d4d4d8;
    border: 1px solid #27272a;
    font-size: 0.78rem;
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
  }

  .card-links {
    display: flex;
    gap: 0.85rem;
    margin-top: auto;
  }

  .btn-live {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--accent);
    color: #000;
    padding: 0.55rem 1rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.88rem;
    transition: background 0.2s;
  }

  .btn-live:hover {
    background: var(--accent-hover);
  }

  .btn-github {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: #18181b;
    color: #fff;
    border: 1px solid var(--border-dark);
    padding: 0.55rem 1rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 500;
    font-size: 0.88rem;
    transition: background 0.2s, border-color 0.2s;
  }

  .btn-github:hover {
    background: #27272a;
    border-color: #3f3f46;
  }

  @media (max-width: 768px) {
    .projects-list {
      grid-template-columns: 1fr;
    }
  }
</style>