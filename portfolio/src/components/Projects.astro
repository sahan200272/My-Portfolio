---
const categories = [
  "All",
  "Website Apps",
  "Mobile APPs",
  "Desktop Apps"
];

const projects = [
  { name: "Breezely", category: "Mobile", img: "/src/assets/Breezely.png" },
  { name: "Name Project", category: "Web", img: "/project2.jpg" },
  { name: "Name Project", category: "Mobile", img: "/project3.jpg" },
  { name: "Name Project", category: "UI/UX", img: "/project4.jpg" },
  { name: "Name Project", category: "Web", img: "/project5.jpg" },
  { name: "Name Project", category: "Mobile", img: "/project6.jpg" },
];
---

<section id="portfolio" class="portfolio">
  <div class="container">
    <h2>Projects</h2>

    <div class="filter-bar">
      {
        categories.map((cat, index) => (
          <button class={index === 0 ? "active" : ""}>{cat}</button>
        ))
      }
    </div>

    <div class="grid">
      {
        projects.map((project) => (
          <div class="project-card">
            <div class="img-holder">
              <img src={project.img} alt={project.name} />
            </div>
            <div class="info">
              <span class="p-name">{project.name}</span>
              <span class="p-cat">{project.category}</span>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .portfolio {
    background: #000;
    padding: 100px 0;
    color: #fff;
    text-align: center;
  }
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  h2 {
    font-size: 2.5rem;
    margin-bottom: 3rem;
  }

  .filter-bar {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 4rem;
    flex-wrap: wrap;
  }
  .filter-bar button {
    background: #1a1a1a;
    color: #fff;
    border: 1px solid #333;
    padding: 0.6rem 1.5rem;
    border-radius: 8px;
    cursor: pointer;
    transition: 0.3s;
  }
  .filter-bar button.active,
  .filter-bar button:hover {
    background: #ff8c00;
    border-color: #ff8c00;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  .project-card {
    background: #1a1a1a;
    border-radius: 15px;
    overflow: hidden;
    text-align: left;
  }
  .img-holder {
    height: 350px;
    background: #333;
    overflow: hidden;
  }
  .img-holder img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .info {
    padding: 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .p-name {
    font-weight: bold;
  }
  .p-cat {
    color: #888;
    font-size: 0.8rem;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
