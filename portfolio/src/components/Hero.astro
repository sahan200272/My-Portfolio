---
// Import your image if it's in src/assets/
// import profileImg from '../assets/profile.png';
---

<section class="hero">
  <div class="container">
    <div class="hero-content">
      <p class="subtitle">Hi I am</p>
      <h2 class="name">Sahan Munasingha</h2>
      <h1 class="title">Software Engineering Undergraduate &<span class="highlight"> Full-Stack Developer</span></h1>

      <h3>I build fast, scalable, and user-friendly web and mobile applications using modern technologies</h3>
      
      <div class="social-icons">
        <a href="https://www.instagram.com/sahan__munasingha/" target="_blank"><i class="ri-instagram-line"></i></a>
        <a href="https://www.linkedin.com/in/sahan-munasingha-26772629b/" target="_blank"><i class="ri-linkedin-box-line"></i></a>
        <a href="https://www.facebook.com/sahan.munasingha.33" target=""><i class="ri-facebook-line"></i></a>
      </div>

      <div class="cta-group">
        <a href="/src/assets/Sahan Munasingha.pdf" download="Sahan_Munasingha_CV" class="btn-secondary">Download CV</a>
      </div>

      <div class="stats-card">
        <div class="stat-item">
          <h3>5+</h3>
          <p>Experiences</p>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <h3>20+</h3>
          <p>Project done</p>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <h3>80+</h3>
          <p>Happy Clients</p>
        </div>
      </div>
    </div>

    <div class="hero-image">
      <div class="image-circle">
        <img src="/src/assets/My Image.jpeg" alt="Sahan Munasingha" />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background-color: #000;
    color: #fff;
    padding: 80px 0;
    overflow: hidden;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 2rem;
  }

  .hero-content {
    flex: 1;
  }

  .subtitle {
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
  }

  .name {
    font-size: 1.5rem;
    font-weight: 400;
    margin-bottom: 0.5rem;
  }

  .title {
    font-size: 4rem;
    font-weight: 800;
    margin-bottom: 1.5rem;
  }

  .highlight {
    color: #ff8c00; /* Main orange accent */
  }

  .social-icons {
    display: flex;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .social-icons a {
    color: #fff;
    font-size: 1.5rem;
    background: #333;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: 0.3s;
  }

  .social-icons a:hover {
    background: #ff8c00;
  }

  .cta-group {
    display: flex;
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .btn-primary {
    background: #ff8c00;
    color: #fff;
    padding: 0.8rem 2rem;
    border-radius: 5px;
    text-decoration: none;
    font-weight: bold;
  }

  .btn-secondary {
    border: 1px solid #fff;
    color: #fff;
    padding: 0.8rem 2rem;
    border-radius: 5px;
    text-decoration: none;
  }

  /* Stats Card Styling */
  .stats-card {
    background: #1a1a1a;
    display: inline-flex;
    padding: 1.5rem 2rem;
    border-radius: 12px;
    gap: 2rem;
    align-items: center;
  }

  .stat-item h3 {
    color: #ff8c00;
    font-size: 1.5rem;
    margin: 0;
  }

  .stat-item p {
    font-size: 0.8rem;
    margin: 0;
    color: #ccc;
  }

  .stat-divider {
    width: 1px;
    height: 40px;
    background: #444;
  }

  /* Image Styling */
  .hero-image {
    flex: 1;
    display: flex;
    justify-content: flex-end;
  }

  .image-circle {
    width: 450px;
    height: 450px;
    background: #ff8c00;
    border-radius: 50%;
    overflow: hidden;
    position: relative;
  }

  .image-circle img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%); /* Matches the B&W photo look */
  }

  /* Responsive */
  @media (max-width: 768px) {
    .container {
      flex-direction: column-reverse;
      text-align: center;
    }
    .hero-image {
      justify-content: center;
      margin-bottom: 2rem;
    }
    .image-circle {
      width: 300px;
      height: 300px;
    }
    .title {
      font-size: 2.5rem;
    }
  }
</style>